# Violet OCR — environment variables.
#
# Copy to `.env` and fill in. Names only here; never commit a filled copy.
# The web app reads NEXT_PUBLIC_* in the browser, everything else server-side.
# The pipeline reads its variables from the Modal secret in production
# (`claude-orchestrator-secrets`) and from this file when run locally.

# ── Supabase ─────────────────────────────────────────────────────────────────
# The anon key is public by design: it ships in the browser bundle. Everything
# it can reach is internet-reachable — see docs/security-model.md before you
# add a table. The service-role key bypasses RLS entirely and must never be
# exposed to the browser or given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The pipeline reads the same project under the unprefixed names.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Web app ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ONE_TAP=false
UPLOAD_DEDUP_ENABLED=true
LEADERBOARD_SEASON_START=

# ── Web → pipeline ───────────────────────────────────────────────────────────
# Both sides compare PIPELINE_SHARED_SECRET on every call. Unset, the pipeline
# refuses the request (fail closed), so an empty value here means uploads stop
# rather than run unauthenticated. Must match the value in the Modal secret.
PIPELINE_SHARED_SECRET=
MODAL_PROCESS_DOCUMENT_URL=
MODAL_GENERATE_EXCEL_URL=

# Vercel Cron sends this as a bearer token to /api/cron/reconcile-jobs, which
# rescues jobs stuck in 'processing'. Unset, the route answers 503.
CRON_SECRET=

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Without these the limiter falls back to in-process counters, which reset on
# every serverless cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Resend if the key is set, otherwise SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL_TO=
FEEDBACK_EMAIL_TO=
SENDGRID_API_KEY=

# ── OCR engines ──────────────────────────────────────────────────────────────
# Azure Document Intelligence supplies the table structure and the cell
# polygons. Nothing else in the pipeline can replace it: no polygons, no crops,
# no name model. The F0 free tier is rate limited — see directives/.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_OCR_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_OCR_ENABLED=true
GEMINI_OCR_MODEL=
GEMINI_OCR_THINKING_BUDGET=
GEMINI_OCR_CORRECTION=true
GEMINI_PREPROCESS=false
GEMINI_NAME_CORRECTION_STAGE4=true
GEMINI_JUDGE_WORKERS=4

# Google Cloud Vision, and the service account the Sheets/Drive exports use.
# These are two different credentials — do not point them at one file out of
# convenience; Vision needs a service account, the Sheets export an OAuth token.
VISION_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# ── Pipeline behaviour ───────────────────────────────────────────────────────
NAME_COLUMN_OCR=true
LORA_NAMES_ENABLED=true
LORA_NAMES_MAX_CELLS=0
CROP_HANDWRITTEN_ONLY=true
DIGIT_REPAIR_ENABLED=true
DIGIT_REPAIR_WORKERS=4
OCR_CONFLICT_RESOLUTION=true
OCR_MATH_RECONCILIATION=true

# ── Orchestrator and alerting ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=

# ── Guards ───────────────────────────────────────────────────────────────────
# test_billing_live.py writes to whatever database it is pointed at. It refuses
# to run unless this is set to 1.
ALLOW_LIVE_BILLING_TEST=
BILLING_TEST_WEB=
