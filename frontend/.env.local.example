# Copy to .env.local and fill in values.
# This file is for the Next.js frontend only. The pipeline and the rest of
# the project read ../.env -- see .env.example in the repository root.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Production base URL — used for password-reset and OAuth callback redirects.
# Without this, Supabase emails point to whatever Site URL the dashboard says.
# Example: https://violet.your-domain.com
# In Vercel: set per-environment so preview deployments stay isolated.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Modal endpoint URL (from: modal deploy execution/modal_webhook.py)
# Example: https://nick-90891--claude-orchestrator-process-document.modal.run
MODAL_PROCESS_DOCUMENT_URL=https://...--claude-orchestrator-process-document.modal.run

# ── Pipeline auth (IMPORTANT for production) ──────────────────────────────────
# Shared secret that authenticates this app to the OCR pipeline endpoints.
# The Modal side now FAILS CLOSED: unset there, it refuses every request. So
# this must hold a long random value, and the SAME string must be set in the
# Modal secret `claude-orchestrator-secrets` as PIPELINE_SHARED_SECRET. A
# mismatch does not degrade gracefully -- every upload fails.
PIPELINE_SHARED_SECRET=

# ── Stuck-job watchdog (Vercel Cron) ──────────────────────────────────────────
# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` when calling
# /api/cron/reconcile-jobs. Set the same value in the Vercel project settings.
CRON_SECRET=

# ── Distributed rate limiting (optional, recommended for production) ───────────
# Without these, rate limiting falls back to per-instance in-memory counters
# (ineffective across serverless instances). Provide an Upstash Redis REST
# endpoint to share counters across all instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
